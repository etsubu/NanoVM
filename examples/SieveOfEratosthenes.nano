; This program will calculate prime numbers with sieve of eratosthenes and prints them to the console

mov reg2, 100 ;print prime numbers under This value

push reg2 ; save for later
; stack allocate
mov bp, sp
mov reg0, reg2
mul reg0, 8
add sp, reg0
; stack memory allocated, initialize values
mov reg0, 2
mov reg3, bp
mov reg1, reg2
sub reg1, 2
:init
store reg3, reg0
add reg3, 8
inc reg0
dec reg1
jnz :init
; Stack memory buffer initialized with candidate numbers


; Run division loop
mov reg1, reg2
sub reg1, 2
mov reg3, bp
:sieve
load reg5, reg3 ; read the number to run divisions with
cmp reg5, 0
jz :sieve_tail

; enter division loop
mov reg2, reg1
dec reg2
mov reg4, reg3
add reg4, 8

cmp reg2, 0
jz :end_division_loop
:division_loop

load reg0, reg4
mod reg0, reg5
cmp reg0, 0
jnz :no_save
store reg4, reg0
:no_save

:end_division_loop
add reg4, 8
dec reg2
jnz :division_loop

:sieve_tail
add reg3, 8
dec reg1
jnz :sieve

; Print results
mov reg0, bp
sub reg0, 8
load reg2, reg0
mov reg1, bp

:loop
load reg0, reg1
cmp reg0, 0
jz :no_print
printi reg0
:no_print

add reg1, 8
dec reg2
jnz :loop
halt